# ==========================================================
# LỚP HỌC VĂN MINH — Environment Variables (VÍ DỤ)
# Copy file này thành .env.local và điền giá trị thật.
# KHÔNG commit .env.local hoặc bất kỳ file .env* nào chứa secret thật.
# ==========================================================

# --- Auth.js ---
# Tạo bằng lệnh: npx auth secret   (hoặc: openssl rand -base64 32)
AUTH_SECRET=

# --- Google OAuth (đăng nhập) ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Google Sheets (lưu trữ dữ liệu nghiệp vụ) ---
GOOGLE_SHEETS_SPREADSHEET_ID=

# --- Google Service Account (chỉ dùng server-side, KHÔNG lộ ra client) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Dán private key giữ nguyên định dạng PEM, thay ký tự xuống dòng bằng \n
# Xem hướng dẫn xử lý newline trên Vercel tại docs/GOOGLE_SHEETS_SETUP.md
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Resend (gửi báo cáo qua email — tính năng "Gửi báo cáo qua email") ---
# Xem hướng dẫn lấy API key + xác minh domain gửi tại docs/EMAIL_REPORTS_SETUP.md
RESEND_API_KEY=
RESEND_FROM_EMAIL="Lớp học Văn minh <baocao@yourdomain.com>"

# --- App ---
NEXT_PUBLIC_APP_NAME="Lớp học Văn minh"

# URL công khai của app (dùng cho Auth.js callback ở production)
# NEXTAUTH_URL=https://your-app.vercel.app
